<?xml version="1.0" encoding="utf-8" ?>
<templates id="template" xml:space="preserve">
    <!-- Full-screen app grid using Odoo 19's native menu selection. -->
    <t t-inherit="web.NavBar.AppsMenu" t-inherit-mode="extension" owl="1">
        <xpath expr="//Dropdown" position="replace">
            <Dropdown menuClass="'o_ohrms_apps_menu_fullscreen'">
                <button data-hotkey="h"
                        class="o_ohrms_apps_toggle"
                        title="Applications">
                    <i class="oi oi-apps"/>
                </button>
                <t t-set-slot="content">
                    <div class="o_ohrms_apps_grid">
                        <DropdownItem
                            t-foreach="apps"
                            t-as="app"
                            t-key="app.id"
                            class="'o_ohrms_app_tile'"
                            onSelected="() => this.onNavBarDropdownItemSelection(app)"
                            attrs="{
                                href: getMenuItemHref(app),
                                'data-menu-xmlid': app.xmlid,
                                'data-section': app.id,
                            }">
                            <img t-if="app.webIconData"
                                 class="o_ohrms_app_icon"
                                 t-att-src="app.webIconData"
                                 t-att-alt="app.name"/>
                            <i t-else="" class="oi oi-apps o_ohrms_app_icon_fallback"/>
                            <span class="o_ohrms_app_name" t-esc="app.name"/>
                        </DropdownItem>
                    </div>
                </t>
            </Dropdown>
        </xpath>
    </t>
</templates>
